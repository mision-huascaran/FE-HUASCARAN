# Pruebas E2E (Playwright). Copie este archivo a .env.e2e (ignorado por git) y
# complete los valores. NUNCA suba .env.e2e ni pegue las contraseñas en un chat.
# En Jenkins no se usa: las variables llegan como credenciales (ver e2e/README.md).

# Aplicación desplegada contra la que se prueba (qa).
BASE_URL=https://qa-huascaran.ingsoftware.lat

# Cuentas que crea el seed del backend en cada despliegue de qa.
E2E_DOCENTE_USER=
E2E_DOCENTE_PASS=
E2E_SUPERVISOR_USER=
E2E_SUPERVISOR_PASS=
E2E_DIRECTIVO_USER=
E2E_DIRECTIVO_PASS=
E2E_INACTIVO_USER=
E2E_INACTIVO_PASS=
