#!/bin/sh
# El `resolver` de nginx.conf solo pregunta al DNS y nunca lee /etc/hosts. Si
# el host de API_UPSTREAM solo está ahí (host.docker.internal en Linux, que
# añade `extra_hosts` en docker-compose.yml), se sustituye por su IP antes de
# generar la configuración. Los nombres que sí están en el DNS (el servicio
# "backend" de una red de Docker o un dominio público) no se tocan.
set -eu

host=$(printf '%s' "${API_UPSTREAM:-}" | sed -E 's#^[a-zA-Z]+://([^/:]+).*#\1#')
ip=$(awk -v h="$host" '$1 !~ /^#/ && $1 !~ /:/ { for (i = 2; i <= NF; i++) if ($i == h) { print $1; exit } }' /etc/hosts)

if [ -n "$host" ] && [ -n "$ip" ]; then
  API_UPSTREAM=$(printf '%s' "$API_UPSTREAM" | sed "s#//$host#//$ip#")
  export API_UPSTREAM
fi
