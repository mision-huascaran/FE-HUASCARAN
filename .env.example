# ─── Cómo llega el frontend a la API ────────────────────────────────────────
#
# Por defecto se usa el PROXY del servidor de desarrollo (ver vite.config.js):
# el navegador llama a su propio origen (/api/...) y Vite reenvía al backend
# desde Node. Funciona con y sin CORS, y —lo importante— funciona igual si abre
# la aplicación en localhost:5173 o en 127.0.0.1:5173, que para el navegador son
# orígenes DISTINTOS.
#
# Además es el mismo modelo del despliegue (§11 del prompt): en producción la API
# vive bajo el mismo dominio con el prefijo /api, así que este valor no cambia.
VITE_API_BASE_URL=/api

# Destino del proxy. Solo se usa en desarrollo.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ─── Alternativa: llamar al backend directamente ────────────────────────────
#
# El backend ya tiene CORS configurado por .env (CORS_ORIGINS). Para saltarse el
# proxy, comente las dos líneas de arriba y descomente esta:
#
#   VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Ojo: entonces hay que entrar por un origen que esté en CORS_ORIGINS del
# backend (http://localhost:5173), NO por http://127.0.0.1:5173.

# ─── De dónde salen los datos ───────────────────────────────────────────────
#
# true  = el negocio se resuelve contra src/api/mock (funciona sin backend).
# false = todo contra la API real.
#
# Desde la semana 11 el backend publica todos los módulos: lo normal es false.
# true solo para trabajar sin backend levantado (el simulador de src/api/mock).
VITE_USE_MOCK=false

# Solo con VITE_USE_MOCK=true: la sesión contra la API real y el resto del mock.
# Con VITE_USE_MOCK=false se ignora (todo es real).
VITE_AUTH_REAL=true

# ─── Despliegue con Docker (docker-compose.yml) ─────────────────────────────
#
# Solo los usa `docker compose`; `npm run dev` los ignora.
#
# Entorno: dev, qa o uat. Da nombre al contenedor (<entorno>-huascaran), que es
# como lo encuentra el proxy del servidor en la red proxy_net.
ENTORNO=dev

# Adónde reenvía Nginx las peticiones a /api: el backend del mismo entorno.
# Solo esquema, host y puerto, sin ruta al final.
#   por el nombre del contenedor del backend en la red proxy_net:
#                    http://dev-bck-huascaran:8000
API_UPSTREAM=http://dev-bck-huascaran:8000

# Solo con VITE_USE_MOCK=true: los módulos conectados (administración,
# Asistencia, Lectura, Rúbrica, Registro de Vuelo, Seguimiento, detalle del
# alumno) contra la API real y la sesión también. Con false se ignora.
#
# Compruebe antes qué hay publicado con:  npm run verificar:backend
VITE_ADMIN_REAL=true
