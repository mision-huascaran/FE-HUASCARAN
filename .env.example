# ─── Cómo llega el frontend a la API ────────────────────────────────────────
#
# Por defecto se usa el PROXY del servidor de desarrollo (ver vite.config.js):
# el navegador llama a su propio origen (/api/...) y Vite reenvía al backend
# desde Node. Funciona con y sin CORS, y —lo importante— funciona igual si abre
# la aplicación en localhost:5173 o en 127.0.0.1:5173, que para el navegador son
# orígenes DISTINTOS.
#
# Además es el mismo modelo del despliegue (§11 del prompt): en producción la API
# vive bajo el mismo dominio con el prefijo /api, así que este valor no cambia.
VITE_API_BASE_URL=/api

# Destino del proxy. Solo se usa en desarrollo.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# ─── Alternativa: llamar al backend directamente ────────────────────────────
#
# El backend ya tiene CORS configurado por .env (CORS_ORIGINS). Para saltarse el
# proxy, comente las dos líneas de arriba y descomente esta:
#
#   VITE_API_BASE_URL=http://127.0.0.1:8000
#
# Ojo: entonces hay que entrar por un origen que esté en CORS_ORIGINS del
# backend (http://localhost:5173), NO por http://127.0.0.1:5173.

# ─── De dónde salen los datos ───────────────────────────────────────────────
#
# true  = el negocio se resuelve contra src/api/mock (funciona sin backend).
# false = todo contra la API real.
#
# HOY DEBE QUEDAR EN true: el backend tiene publicada la autenticación
# (POST /login, GET /me, POST /logout) pero ningún endpoint de negocio, así que
# con false la aplicación entra pero no tiene qué mostrar.
VITE_USE_MOCK=true

# Autenticación contra la API real mientras el negocio sigue en mock.
#
# Es el modo de integración de hoy: la sesión, el token JWT y el perfil salen del
# backend de verdad; alumnos, evaluaciones y consolidados, del mock. Póngalo en
# false para trabajar sin backend levantado.
VITE_AUTH_REAL=true
